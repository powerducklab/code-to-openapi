                      },
                      "required": [
                        "updatedAt",
                        "createdAt",
                        "bio",
                        "image",
                        "username",
                        "email",
                        "id",
                        "token"
                      ]
                    }
                  },
                  "required": [
                    "user"
                  ]
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "user": {
                    "type": "object",
                    "properties": {
