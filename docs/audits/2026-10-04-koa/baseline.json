                      "username": {
                        "type": "string",
                        "maxLength": 30
                      },
                      "image": {
                        "type": "string"
                      },
                      "bio": {
                        "type": "string"
                      },
                      "createdAt": {
                        "type": "string"
                      },
                      "updatedAt": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "email",
                      "password",
                      "username"
                    ]
                  }
                },
                "required": [
                  "user"
                ]
              }
            }
          }
        }
      }
