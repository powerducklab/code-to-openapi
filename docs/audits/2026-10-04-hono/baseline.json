    "/profiles/{username}": {
      "get": {
        "summary": "Get Profile",
        "responses": {
          "200": {
            "description": "Profile found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "profile": {
                      "type": "object",
                      "properties": {
                        "username": {
                          "type": "string",
                          "minLength": 2,
                          "description": "The username of the user",
                          "example": "jake"
                        },
                        "bio": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "minLength": 2,
                          "description": "The bio of the user",
                          "example": "I work at statefarm"
                        },
                        "image": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "format": "uri",
                          "description": "The image of the user",
                          "example": "https://api.realworld.io/images/smiley-cyrus.jpg"
                        },
                        "following": {
                          "type": "boolean",
                          "description": "Whether the user is following the profile",
                          "example": true
                        }
                      },
                      "required": [
                        "username",
                        "following"
                      ]
                    }
                  },
                  "required": [
                    "profile"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Profile not found"
          }
        }
